# Chave da API do Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Modo: "auto" (bot responde tudo) ou "manual" (bot so responde quando ausente)
AGENT_MODE=auto

# Numeros que o bot NUNCA vai responder automaticamente (separados por virgula)
# Coloque aqui numeros importantes: parceiros, familia, etc.
# Formato: 5512999999999 (com DDI+DDD, sem + ou espacos)
BLOCKED_NUMBERS=

# Prefixo para voce assumir a conversa manualmente
# Se voce enviar uma mensagem comecando com este prefixo, o bot para de responder aquele contato
MANUAL_PREFIX=!manual

# Prefixo para reativar o bot em uma conversa
BOT_PREFIX=!bot

# Quanto tempo (em horas) o bot fica em silencio apos receber uma mensagem de voz/audio
# (audios sao ignorados pelo bot por padrao)
AUDIO_SILENCE_HOURS=0

# Nome do Railway environment (nao muda)
PORT=3000
